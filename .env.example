# Discord Authentication
HOST="127.0.0.1"
PORT=3000
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
OWNER_DISCORD_USER_ID=""
OWNER_ALIASES="Spin,สปิน"

# Local AI Engine Providers (Zero-Cost Local Default)
STT_PROVIDER=local
STT_RETRY_BLANK_WITH_FALLBACK=true
STT_MIN_RMS_DBFS=-52
STT_MIN_AUDIO_MS=250
STT_SAVE_REJECTED_AUDIO=true
STT_BASE_URL="http://127.0.0.1:8765"
# Accurate default for the RTX 5090 Laptop. The service falls back to 0.6B when GPU headroom is low.
STT_MODEL="Qwen/Qwen3-ASR-1.7B"
STT_ACCURATE_MODEL="Qwen/Qwen3-ASR-1.7B"
STT_FALLBACK_MODEL="Qwen/Qwen3-ASR-0.6B"
STT_LARGE_MODEL_MIN_FREE_GB=6.5
STT_TIMEOUT_MS=60000
# Leave blank for live Discord. A long keyword prompt can be echoed as a false transcript on noisy clips.
STT_CONTEXT=""
STT_ALLOWED_LANGUAGES="Thai,English"
STT_FALLBACK_LANGUAGE="Thai"

LLM_PROVIDER=local
LLM_BASE_URL="http://127.0.0.1:11434/v1"
# Imported AtomicChat GGUF profile for RTX 5090 Laptop 24 GB + 64 GB system RAM.
LLM_MODEL="digital-me-qwen38:27b-ad-q4km"
LLM_ENABLED=true
# Warm replies are fast; this ceiling also permits a one-time 17 GB cold load after Ollama released VRAM.
LLM_TIMEOUT_MS=60000
LLM_RESEARCH_TIMEOUT_MS=120000
LLM_RESEARCH_REASONING_EFFORT="medium"
LLM_CONTEXT_TOKENS=8192
# Ollama accepts a large value as "offload every layer that fits".
LLM_GPU_LAYERS=999
# start:local caps the 64-layer model here so the complete voice stack fits beside it on a 24 GB GPU.
LLM_VOICE_GPU_LAYERS=48
# Release idle LLM VRAM so accurate ASR, JaiTTS, or RVC can take over the GPU.
LLM_KEEP_ALIVE="10m"
# Standalone /jarvis-lab uses profile `interactive` when JARVIS_STANDALONE=1:
# longer keep-alive, no JaiTTS/RVC reservation, default context 4096. start:local stays `voice`.
# JARVIS_PROFILE=interactive
# JARVIS_INTERACTIVE_KEEP_ALIVE=30m
# JARVIS_INTERACTIVE_CONTEXT_TOKENS=4096
# JARVIS_INTERACTIVE_TIMEOUT_MS=120000
# Set JARVIS_KEEP_VOICE_CONTEXT=1 to keep LLM_CONTEXT_TOKENS=8192 in the lab.
#
# Canonical standalone Jarvis Qwen runtime (llama.cpp OpenAI-compatible).
# Discord/Digital Me still uses LLM_BASE_URL/LLM_MODEL above (Ollama).
# Do not put the API key in git. LOCAL_QWEN_API_KEY is preferred; JARVIS_QWEN_API_KEY also works.
# JARVIS_LLM_BASE_URL="http://127.0.0.1:8086/v1"
# JARVIS_LLM_MODEL="qwen38-cyber"
# LOCAL_QWEN_BASE_URL="http://127.0.0.1:8086/v1"
# LOCAL_QWEN_MODEL="qwen38-cyber"
# LOCAL_QWEN_API_KEY=""
LLM_RETRY_COOLDOWN_MS=5000
VOICE_REPLY_MAX_WORDS=22
VOICE_REPLY_MAX_CHARS=240

# Read-only realtime intelligence. The installer pins world-intel-mcp to an audited commit.
RESEARCH_ENABLED=true
WORLD_INTEL_MCP_COMMAND=""
WORLD_INTEL_TIMEOUT_MS=30000
# Aggregated briefs query many upstream feeds and need a wider cancellation window.
WORLD_INTEL_EXPENSIVE_TIMEOUT_MS=60000
# URLs are collected from the full response; only the evidence text given to the 8K model is bounded.
WORLD_INTEL_MAX_OUTPUT_CHARS=8000
WORLD_INTEL_ALLOWED_TOOLS="intel_status,intel_news_feed,intel_trending_keywords,intel_gdelt_search,intel_world_brief,intel_daily_digest,intel_market_quotes,intel_crypto_quotes,intel_forex_rates,intel_earthquakes,intel_disaster_alerts,intel_ai_releases,intel_hacker_news,intel_arxiv_papers"
ALLOW_UNPROMPTED_RESPONSES=false
UNPROMPTED_RESPONSE_COOLDOWN_MS=10000
RESPOND_IN_ONE_ON_ONE=true
# Initial state after each server restart. The dashboard Session card can pause/resume this per Discord server.
VC_AUTO_RESPONSE_DEFAULT=true
# Keep the local dashboard from watching model/dataset/runtime files and consuming CPU.
DISABLE_HMR=true

EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL="http://127.0.0.1:8767"
EMBEDDING_MODEL="Qwen3-Embedding-0.6B"

TTS_PROVIDER=local
TTS_BASE_URL="http://127.0.0.1:8766"
TTS_MODEL="auto-benchmarked"
VOICE_REFERENCE_PATH="data/voice/owner_reference.wav"

# Local RTX RVC Training + Inference (default)
VOICE_BACKEND=local
VOICE_SERVICE_URL="http://127.0.0.1:8766"
# Optional fixed secret for running voice:start separately. start:local generates an in-process secret when empty.
VOICE_API_TOKEN=""
VOICE_DATA_ROOT="data/local_voice"
RVC_ROOT=".runtime/Retrieval-based-Voice-Conversion-WebUI"
# Dashboard Voice Changer upload limits and server-side conversion timeout.
MAX_VOICE_CONVERSION_BYTES=104857600
MAX_VOICE_CONVERSION_SECONDS=600
VOICE_CONVERT_TIMEOUT_MS=3600000
MAX_VOICE_CONVERSION_RESPONSE_BYTES=209715200
VOICE_CONVERSION_SPEECH_RTF=0.7
VOICE_CONVERSION_VOCAL_RTF=0.8
VOICE_CONVERSION_SONG_RTF=1.6
RVC_BATCH_SIZE=8
RVC_EPOCHS=100
RVC_WORKERS=4
RVC_CPU_THREADS=8
RVC_LOW_PRIORITY=true
RVC_FINETUNE_LR_SCALE=0.25
RVC_INDEX_RATE=0.55
RVC_RMS_MIX_RATE=1.0
RVC_PROTECT=0.20
# Singing keeps the source melody and dynamics while protecting breaths/consonants.
SONG_RVC_INDEX_RATE=0.85
SONG_RVC_RMS_MIX_RATE=0.50
SONG_RVC_PROTECT=0.18
SONG_SEPARATOR_MODEL=htdemucs
SONG_SEPARATOR_DEVICE=cuda
# Default extra vocal presence when remixing a converted singer with instruments.
SONG_VOCAL_BOOST_DB=3.0
EDGE_TTS_VOICE="th-TH-NiwatNeural"
EDGE_TTS_RATE="-8%"
EDGE_TTS_PITCH="+0Hz"
# Standalone /jarvis-lab speech (JF-009). Jarvis native uses Edge-TTS and does not start JaiTTS/RVC.
# Clone voices need consent + speaker mapping. Do not set these to silently impersonate another voice.
# STANDALONE_CLONE_CONSENT=gam
# STANDALONE_GAM_SPEAKER_ID=""
# STANDALONE_ELEMISU_SPEAKER_ID=""
# STANDALONE_EDGE_TTS_PYTHON=".venv-rvc/Scripts/python.exe"
EDGE_TTS_VOLUME="+0%"
EDGE_TTS_REFERENCE_PITCH_HZ=160
EDGE_TTS_REFERENCE_RATE_WPS=5.5
EDGE_TTS_LEARN_RATE=false
# Expressive Thai source voice for personal/non-commercial use. Replace this backend before a commercial release unless its license changes.
# Speakers without an approved reference manifest automatically use Edge-TTS.
JAITTS_ENABLED=true
JAITTS_BASE_URL="http://127.0.0.1:8768"
# Leave blank when using start:local; it shares the generated VOICE_API_TOKEN.
JAITTS_API_TOKEN=""
JAITTS_MODEL_ID="JTS-AI/JaiTTS-F5TTS"
# Measured local default. Alternatives: balanced, quality, or default (explicit NFE/CFG below).
JAITTS_PRESET="realtime"
JAITTS_STEPS=32
JAITTS_CFG_STRENGTH=2.5
JAITTS_SPEED=0.75
JAITTS_TIMEOUT_MS=30000
# Enable only for a local controlled benchmark; arbitrary NFE/CFG request fields are ignored otherwise.
JAITTS_ALLOW_BENCHMARK_CONTROLS=false
DEFAULT_SPEAKER_ID=""
AUTO_TRAIN_MIN_SECONDS=120
AUTO_TRAIN_ON_UPLOAD=false
LEARNING_FIRST_MODEL_SECONDS=120
LEARNING_FINETUNE_NEW_SECONDS=180
LEARNING_RESUME_AFTER_RESTART=true
LEARNING_FINETUNE_EPOCHS=35

# Legacy cloud compatibility (not recommended for Colab-managed runtimes)
COLAB_VOICE_URL=""
COLAB_TTS_URL=""
COLAB_API_TOKEN=""
COLAB_STT_URL=""
TTS_TIMEOUT_MS=60000
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Privacy & System Controls
RECORD_RAW_AUDIO=false
VOICE_END_SILENCE_MS=650
VOICE_UTTERANCE_GRACE_MS=350
VOICE_RESPONSE_COOLDOWN_MS=700
VOICE_BARGE_IN_MIN_MS=320
VOICE_BARGE_IN_MIN_RMS_DBFS=-42
VOICE_MIN_UTTERANCE_MS=250
TRANSCRIPT_RETENTION=true
MEMORY_ENABLED=true
MEMORY_RETENTION=true
LOG_LEVEL="info"
