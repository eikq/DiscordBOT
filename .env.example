# Discord Authentication
HOST="127.0.0.1"
PORT=3000
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
OWNER_DISCORD_USER_ID=""
OWNER_ALIASES="Spin,สปิน"

# Local AI Engine Providers (Zero-Cost Local Default)
STT_PROVIDER=local
STT_BASE_URL="http://127.0.0.1:8765"

LLM_PROVIDER=local
LLM_BASE_URL="http://127.0.0.1:8080/v1"
LLM_MODEL="typhoon2.5-qwen3-4b"
LLM_ENABLED=true
LLM_TIMEOUT_MS=1500
LLM_RETRY_COOLDOWN_MS=30000
ALLOW_UNPROMPTED_RESPONSES=false

EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL="http://127.0.0.1:8767"
EMBEDDING_MODEL="Qwen3-Embedding-0.6B"

TTS_PROVIDER=local
TTS_BASE_URL="http://127.0.0.1:8766"
TTS_MODEL="auto-benchmarked"
VOICE_REFERENCE_PATH="data/voice/owner_reference.wav"

# Optional Cloud Backstops (Disabled by default)
# Authenticated Colab RVC service. The URL changes whenever the Colab tunnel restarts.
COLAB_VOICE_URL=""
COLAB_TTS_URL="" # legacy alias; COLAB_VOICE_URL wins
COLAB_API_TOKEN="" # same long random secret used in the Colab notebook
COLAB_STT_URL="" # optional separate speech-to-text endpoint; the RVC service is TTS/training only
TTS_TIMEOUT_MS=60000
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Privacy & System Controls
RECORD_RAW_AUDIO=false
TRANSCRIPT_RETENTION=true
MEMORY_ENABLED=true
MEMORY_RETENTION=true
LOG_LEVEL="info"
