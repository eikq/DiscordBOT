# JARVIS Community Edition — sanitized template
# Copy to .env.community (do not commit the copy).
# Community JARVIS runs standalone. Discord tokens are not required.

JARVIS_EDITION=community
JARVIS_STANDALONE=1
HOST=127.0.0.1
PORT=3012

# OpenAI-compatible local model. Any compatible server works.
# Do not treat a specific model name as mandatory.
# JARVIS_LLM_MODEL must match an id from GET $JARVIS_LLM_BASE_URL/models
# or Presence will show LOCAL MODEL OFFLINE / MODEL_NOT_FOUND.
JARVIS_LLM_BASE_URL=http://127.0.0.1:8086/v1
JARVIS_LLM_MODEL=local-model
# JARVIS_LLM_API_KEY=

# Optional isolated data root. Default is <repo>/data/community/
# JARVIS_DATA_ROOT=

RECORD_RAW_AUDIO=false
LLM_ENABLED=true
