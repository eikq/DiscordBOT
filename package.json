{
  "name": "digital-me-discord-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/server.cjs')\"",
    "test": "tsx --test tests/*.test.ts && python -m unittest discover -s tests -p \"test_*.py\"",
    "verify": "npm run lint && npm test && npm run verify:colab && npm run build && npm run simulate:p2 && npm run simulate:p3 && npm run simulate:p4 && npm run stress",
    "verify:colab": "python -m py_compile colab/voice_service.py colab/voice_output_audio.py colab/voice_prosody.py colab/cloud_training_export.py colab/rvc_train_runner.py colab/bootstrap_colab.py colab/bootstrap_local.py cloud/vast/run_vast_training.py python/local_stt_service.py python/jaitts_service.py scripts/test_jaitts_voice.py && node -e \"JSON.parse(require('fs').readFileSync('colab/DigitalMe_RVC_Colab.ipynb','utf8')); console.log('Voice backend Python, cloud export, JaiTTS, and legacy Colab notebook verified')\"",
    "simulate": "tsx src/bot/simulate.ts",
    "simulate:p2": "tsx src/bot/simulatePhase2.ts",
    "simulate:p3": "tsx src/bot/simulatePhase3.ts",
    "simulate:p4": "tsx src/bot/simulatePhase4.ts",
    "doctor": "tsx scripts/doctor.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "annotate": "tsx scripts/annotate.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:owner": "tsx scripts/evaluate_owner.ts",
    "voice:guide": "tsx scripts/voice_guide.ts",
    "stress": "tsx scripts/stress.ts",
    "smoke:voice": "tsx scripts/smoke_voice_conversation.ts",
    "start:local": "tsx scripts/start_local.ts",
    "voice:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_local_voice.ps1",
    "voice:start": "tsx scripts/start_local_voice.ts",
    "stt:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_local_stt.ps1",
    "stt:start": "tsx scripts/start_local_stt.ts",
    "jaitts:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_local_jaitts.ps1",
    "jaitts:start": ".venv-jaitts\\Scripts\\python.exe python/jaitts_service.py",
    "jaitts:benchmark": ".venv-jaitts\\Scripts\\python.exe scripts/benchmark_jaitts.py",
    "fine-tune:prepare": "tsx scripts/validate_dataset.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opusscript": "^0.0.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  }
}
