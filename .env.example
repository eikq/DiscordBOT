# Discord Authentication
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
OWNER_DISCORD_USER_ID=""
OWNER_ALIASES="Spin,สปิน"

# Local AI Engine Providers (Zero-Cost Local Default)
STT_PROVIDER=local
STT_BASE_URL="http://127.0.0.1:8765"

LLM_PROVIDER=local
LLM_BASE_URL="http://127.0.0.1:8080/v1"
LLM_MODEL="typhoon2.5-qwen3-4b"

EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL="http://127.0.0.1:8767"
EMBEDDING_MODEL="Qwen3-Embedding-0.6B"

TTS_PROVIDER=local
TTS_BASE_URL="http://127.0.0.1:8766"
TTS_MODEL="auto-benchmarked"
VOICE_REFERENCE_PATH="data/voice/owner_reference.wav"

# Optional Cloud Backstops (Disabled by default)
COLAB_TTS_URL=""
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Privacy & System Controls
RECORD_RAW_AUDIO=false
TRANSCRIPT_RETENTION=true
MEMORY_ENABLED=true
MEMORY_RETENTION=true
LOG_LEVEL="info"
