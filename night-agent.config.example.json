{
  "version": 1,
  "profile": "DEV_NIGHT",
  "maxRuntimeHours": 6,
  "maxTasks": 8,
  "maxAttemptsPerTask": 3,
  "defaultTaskMaxMinutes": 30,
  "agentSlots": 1,
  "allowNetwork": false,
  "allowDependencyInstall": false,
  "allowGitCommit": false,
  "ownerApprovedGitCommit": false,
  "allowGitPush": false,
  "allowDestructiveGit": false,
  "allowCreateWorktree": false,
  "allowDirtyWorkspace": false,
  "cloudEscalation": { "enabled": false },
  "workerProviders": [
    {
      "id": "local-qwen",
      "kind": "local-qwen",
      "enabled": true,
      "priority": 100,
      "freshSessionPerTask": true
    }
  ],
  "fallbackOn": ["quota_exhausted", "model_unavailable", "auth_error", "provider_error"],
  "qwen": {
    "model": "digital-me-qwen38:27b-ad-q4km",
    "baseUrl": "http://127.0.0.1:11434",
    "contextTokens": 32768,
    "keepAlive": "30m",
    "timeoutMs": 180000,
    "maxToolRounds": 12,
    "temperature": 0.1,
    "gpuLayers": 999
  },
  "privatePathDenylist": [
    ".env",
    ".runtime",
    "data/voice_samples",
    "data/local_voice",
    "data/brain",
    "data/memory",
    "data/jarvis/jarvis.db"
  ]
}