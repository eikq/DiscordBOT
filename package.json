{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "simulate": "tsx src/bot/simulate.ts",
    "simulate:p2": "tsx src/bot/simulatePhase2.ts",
    "simulate:p3": "tsx src/bot/simulatePhase3.ts",
    "simulate:p4": "tsx src/bot/simulatePhase4.ts",
    "doctor": "tsx scripts/doctor.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "annotate": "tsx scripts/annotate.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:owner": "tsx scripts/evaluate_owner.ts",
    "voice:guide": "tsx scripts/voice_guide.ts",
    "stress": "tsx scripts/stress.ts",
    "start:local": "tsx scripts/start_local.ts",
    "fine-tune:prepare": "tsx scripts/validate_dataset.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  }
}
